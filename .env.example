# Supabase project settings. Both values are public identifiers; RLS protects user data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never add a service-role key or exchange/banking credentials.

# Enable only after database requirements and security are verified.
NEXT_PUBLIC_QUICKEXIT_ACCOUNTS_ENABLED=false

# Separate public signup gate. Keep false until hosted verification and explicit approval.
NEXT_PUBLIC_QUICKEXIT_REGISTRATION_ENABLED=false

# Optional trusted CI commit metadata: a full 40-character Git SHA only.
# Vercel's VERCEL_GIT_COMMIT_SHA or the local Git checkout supplies a default.
QUICKEXIT_BUILD_COMMIT=
